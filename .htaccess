# Mas Cargo MVC Routing .htaccess

Options -Indexes
DirectoryIndex index.php
ServerSignature Off

RewriteEngine On
RewriteBase /

# Sensitive paths and project internals must look nonexistent.
RewriteRule (^|/)(\.git|\.env|app|config|includes|database|storage|logs|vendor|node_modules)(/|$) - [R=404,L,NC]
RewriteRule (^|/)(backup[^/]*|phpinfo\.php|config\.php|composer\.(json|lock)|package(-lock)?\.json|Dockerfile|docker-compose\.ya?ml|README\.md)$ - [R=404,L,NC]
RewriteRule \.(sql|bak|zip|tar|tgz|gz|log|ini|env|yml|yaml|lock)$ - [R=404,L,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]
